# Copy this file to .env and fill in real values before running in production.

# MongoDB connection string (MongoDB Atlas free tier recommended).
# If left unset, the server uses a temporary in-memory database for local dev only —
# data will NOT be saved between restarts.
MONGODB_URI=

# Long random string used to sign admin login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=4000

# Public URL of the deployed frontend (no trailing slash). Used by the
# /api/share/* routes to build the redirect link crawlers/visitors land on.
FRONTEND_URL=http://localhost:5173

# Optional: if set, and no admin accounts exist yet, the server creates this
# superadmin automatically on boot. Useful for first deployment (no shell
# access needed) or local dev. Leave unset after your first admin exists.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
